<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {% endif %}원벌룬앤파티</title>
  <meta name="description" content="{{ seo_description or summary or site.description }}">
  <meta name="robots" content="index,follow">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{% if title %}{{ title }} | {% endif %}원벌룬앤파티">
  <meta property="og:description" content="{{ seo_description or summary or site.description }}">
  <meta property="og:type" content="{% if page.url.startsWith('/cases/') and page.url != '/cases/' %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% if cover_image %}<meta property="og:image" content="{{ site.url }}{{ cover_image }}">{% endif %}
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="stylesheet" href="/assets/styles.css">

  <script type="application/ld+json">
  {
    "@context":"https://schema.org",
    "@type":"LocalBusiness",
    "name":"원벌룬앤파티",
    "alternateName":"ONE BALLOON & PARTY",
    "url":"https://oneballoon.co.kr/",
    "telephone":"+82-10-6491-9061",
    "logo":"https://oneballoon.co.kr/assets/logo.png",
    "description":"서울·부천·인천·경기 지역 학교·유치원·기업행사 풍선장식 및 포토존 제작·설치",
    "areaServed":["서울","부천","인천","경기"],
    "knowsAbout":["학교 졸업식 풍선장식","학교 입학식 풍선장식","유치원·어린이집 행사장식","졸업식 포토존","학교 강당 무대장식","음악·예술 발표회 장식","기업행사 풍선장식","관공서 행사 풍선장식","팝업스토어 공간장식"],
    "sameAs":["https://blog.naver.com/oneballoon_topper"]
  }
  </script>
  {% block head %}{% endblock %}
</head>
<body>
<header class="topbar">
  <a class="brand" href="/" aria-label="원벌룬앤파티 홈">
    <img src="/assets/logo.png" alt="원벌룬앤파티 로고">
  </a>
  <nav>
    <a href="/#services">서비스</a>
    <a href="/cases/">시공사례</a>
    <a href="/#area">출장지역</a>
    <a href="/#contact">상담문의</a>
  </nav>
</header>

<main>
{% block content %}{{ content | safe }}{% endblock %}
</main>

<footer>
  <img src="/assets/logo.png" alt="" aria-hidden="true">
  <p>© 2026 ONE BALLOON & PARTY. All rights reserved.</p>
</footer>
</body>
</html>
