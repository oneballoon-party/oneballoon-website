{% extends "base.njk" %}

{% block head %}
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"Article",
  "headline": {{ title | dump | safe }},
  "description": {{ (seo_description or summary) | dump | safe }},
  "datePublished":"{{ date.toISOString() }}",
  "author":{
    "@type":"Organization",
    "name":"원벌룬앤파티"
  },
  "publisher":{
    "@type":"Organization",
    "name":"원벌룬앤파티",
    "logo":{
      "@type":"ImageObject",
      "url":"https://oneballoon.co.kr/assets/logo.png"
    }
  }
  {% if cover_image %},
  "image":["https://oneballoon.co.kr{{ cover_image }}"]
  {% endif %}
}
</script>
{% endblock %}


{% block content %}

<article class="case-detail">

  <header class="case-hero">

    <p class="eyebrow">
      {{ category }}
      {% if region %}
        · {{ region }}
      {% endif %}
    </p>

    <h1>{{ title }}</h1>

    {% if summary %}
      <p class="case-summary">{{ summary }}</p>
    {% endif %}

    <p class="case-date">{{ date | dateKo }}</p>


    {% if cover_image %}
      <figure class="case-photo-block case-cover-block">

        <img
          class="case-cover"
          src="{{ cover_image }}"
          alt="{{ cover_alt or title }}"
        >

        {% if cover_alt %}
          <figcaption class="photo-description">
            {{ cover_alt }}
          </figcaption>
        {% endif %}

      </figure>
    {% endif %}

  </header>


  {% if content %}
    <div class="case-intro prose">
      {{ content | safe }}
    </div>
  {% endif %}


  {% if gallery %}
    <section class="case-gallery">

      <h2>현장 사진</h2>

      <div class="gallery-story">

        {% for item in gallery %}

          <figure class="case-photo-block">

            <img
              src="{{ item.image }}"
              alt="{{ item.alt or title }}"
              loading="lazy"
            >

            {% if item.alt %}
              <figcaption class="photo-description">
                {{ item.alt }}
              </figcaption>
            {% endif %}

          </figure>

        {% endfor %}

      </div>

    </section>
  {% endif %}


  <div class="case-cta">

    <h2>행사 상담</h2>

    <p>
      날짜 · 장소 · 예산 · 원하는 분위기를 알려주시면
      공간에 맞는 풍선장식과 포토존 상담을 도와드립니다.
    </p>

    <a
      class="btn primary"
      href="{{ site.phoneHref }}"
    >
      {{ site.phoneDisplay }}
    </a>

    <a
      class="btn"
      href="{{ site.blog }}"
      target="_blank"
      rel="noopener"
    >
      네이버 블로그
    </a>

  </div>

</article>


<style>

.case-photo-block {
  margin: 0 0 48px;
}

.case-photo-block img {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 18px;
}

.photo-description {
  margin: 14px 4px 0;
  font-size: 16px;
  line-height: 1.8;
  color: #555;
}

.case-intro {
  margin-top: 42px;
  margin-bottom: 56px;
}

.case-gallery {
  margin-top: 56px;
}

.case-gallery h2 {
  margin-bottom: 28px;
}

.gallery-story {
  display: block;
}

.case-cta {
  margin-top: 64px;
}


@media (max-width: 640px) {

  .case-photo-block {
    margin-bottom: 38px;
  }

  .photo-description {
    margin-top: 11px;
    font-size: 15px;
    line-height: 1.7;
  }

  .case-intro {
    margin-top: 32px;
    margin-bottom: 44px;
  }

  .case-gallery {
    margin-top: 44px;
  }

  .case-gallery h2 {
    margin-bottom: 22px;
  }

  .case-cta {
    margin-top: 52px;
  }

}

</style>

{% endblock %}
