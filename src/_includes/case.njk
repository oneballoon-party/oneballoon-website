{% extends "base.njk" %}

{% block head %}
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"Article",
  "headline": {{ title | dump | safe }},
  "description": {{ (seo_description or summary) | dump | safe }},
  "datePublished":"{{ date.toISOString() }}",
  "author":{
    "@type":"Organization",
    "name":"원벌룬앤파티"
  },
  "publisher":{
    "@type":"Organization",
    "name":"원벌룬앤파티",
    "logo":{
      "@type":"ImageObject",
      "url":"https://oneballoon.co.kr/assets/logo.png"
    }
  }
  {% if cover_image %},
  "image":["https://oneballoon.co.kr{{ cover_image }}"]
  {% endif %}
}
</script>
{% endblock %}


{% block content %}

<article class="case-detail">

  <header class="case-hero">

    <p class="eyebrow">
      {{ category }}
      {% if region %}
        · {{ region }}
      {% endif %}
    </p>

    <h1>{{ title }}</h1>

    {% if summary %}
      <p class="case-summary">{{ summary }}</p>
    {% endif %}

    <p class="case-date">{{ date | dateKo }}</p>


    {% if cover_image %}
      <figure class="case-photo-block case-cover-block">

        <img
          class="case-cover"
          src="{{ cover_image }}"
          alt="{{ cover_alt or title }}"
        >

        {% if cover_alt %}
          <figcaption class="photo-description">
            {{ cover_alt }}
          </figcaption>
        {% endif %}

      </figure>
    {% endif %}

  </header>


  {% if content %}
    <div class="case-intro prose">
      {{ content | safe }}
    </div>
  {% endif %}


  {% if gallery %}
    <section class="case-gallery">

      <h2>현장 사진</h2>

      <div class="gallery-story">

        {% for item in gallery %}

          <figure class="case-photo-block">

            <img
              src="{{ item.image }}"
              alt="{{ item.alt or title }}"
              loading="lazy"
            >

            {% if item.alt %}
              <figcaption class="photo-description">
                {{ item.alt }}
              </figcaption>
            {% endif %}

          </figure>

        {% endfor %}

      </div>

    </section>
  {% endif %}


  <div class="case-cta">

    <h2>행사 상담</h2>

    <p>
      날짜 · 장소 · 예산 · 원하는 분위기를 알려주시면
      공간에 맞는 풍선장식과 포토존 상담을 도와드립니다.
    </p>

    <a
      class="btn primary"
      href="{{ site.phoneHref }}"
    >
      {{ site.phoneDisplay }}
    </a>

    <a
      class="btn"
      href="{{ site.blog }}"
      target="_blank"
      rel="noopener"
    >
      네이버 블로그
    </a>

  </div>

</article>


<style>

/* 시공사례 상단 */
.case-hero {
  text-align: center;
}

.case-summary {
  max-width: 760px;
  margin-left: auto;
  margin-right: auto;
  line-height: 1.8;
}


/* 사진 + 사진 설명 한 세트 */
.case-photo-block {
  width: 100%;
  max-width: 900px;
  margin: 0 auto 72px;
  text-align: center;
}

.case-photo-block img {
  display: block;
  width: 100%;
  height: auto;
  margin: 0 auto;
  border-radius: 18px;
}


/* 사진 아래 설명 */
.photo-description {
  max-width: 760px;
  margin: 18px auto 0;
  padding: 0 12px;
  font-size: 18px;
  line-height: 1.8;
  color: #444;
  text-align: center;
  word-break: keep-all;
}


/* 본문 소개 */
.case-intro {
  max-width: 820px;
  margin: 48px auto 68px;
  text-align: center;
  line-height: 1.9;
  word-break: keep-all;
}

.case-intro p {
  margin-left: auto;
  margin-right: auto;
}


/* 현장 사진 영역 */
.case-gallery {
  margin-top: 68px;
}

.case-gallery h2 {
  margin-bottom: 42px;
  text-align: center;
}

.gallery-story {
  display: block;
}


/* 상담 영역 */
.case-cta {
  max-width: 820px;
  margin: 80px auto 0;
  text-align: center;
}


/* 모바일 */
@media (max-width: 640px) {

  .case-photo-block {
    max-width: 100%;
    margin-bottom: 56px;
  }

  .photo-description {
    max-width: 92%;
    margin-top: 14px;
    padding: 0;
    font-size: 17px;
    line-height: 1.75;
  }

  .case-intro {
    max-width: 92%;
    margin-top: 38px;
    margin-bottom: 54px;
    line-height: 1.8;
  }

  .case-gallery {
    margin-top: 54px;
  }

  .case-gallery h2 {
    margin-bottom: 30px;
  }

  .case-cta {
    max-width: 92%;
    margin-top: 62px;
  }

}

</style>

{% endblock %}
